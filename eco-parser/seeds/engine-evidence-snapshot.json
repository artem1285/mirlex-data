      "chain": "SOURCE → RIGHT/LICENCE_OR_EXCEPTION → CONDITIONS → EXTRACTION → METERING → REPORTING → CLOSURE",
      "radar_ids": [
        "IND-WATERINTAKE-001"
      ]
    },
    {
      "rule_id": "ENG-UNI-LOS-001",
      "gate": "TREATMENT",
      "trigger": "treatment/separator exists",
      "chain": "INFLUENT → TREATMENT → EFFICIENCY → EFFLUENT_ROUTE → LAB → SLUDGE → FINAL_ROUTE → FAILURE",
      "radar_ids": [
        "IND-LOS-001",
        "IND-WATER-001"
      ]
    },
    {
      "rule_id": "ENG-UNI-AIR-001",
      "gate": "AIR",
      "trigger": "process may create emissions",
      "chain": "TECHNOLOGY → MATERIAL/FUEL/ADDITIVE → PROCESS → POLLUTANT → SOURCE → INVENTORY → CONTROL → MEASUREMENT",
      "radar_ids": [
        "IND-AIR-001"
      ]
    },
    {
      "rule_id": "ENG-UNI-WASTE-001",
      "gate": "WASTE",
      "trigger": "waste/residue/by-product generated",
      "chain": "GENERATION → STATUS → PROPERTIES → ACCUMULATION → WEATHER/SURFACE → TRANSPORT → RECIPIENT → FINAL_OPERATION → MASS_BALANCE",
      "radar_ids": [
        "IND-WASTESAN-002"
      ]
    },
    {
      "rule_id": "ENG-UNI-SOIL-001",
      "gate": "SOIL",
      "trigger": "substance may contact soil",
      "chain": "SUBSTANCE → SOIL_CONTACT → SAMPLING → STANDARD_OR_BACKGROUND → AREA/DEPTH → DAMAGE → RESTORATION",
      "radar_ids": [
        "IND-SOIL-001"
      ]
    },
    {
      "rule_id": "ENG-UNI-STORM-001",
